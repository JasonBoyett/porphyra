{
  "name": "porphyra",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "server/auth",
    "server/api",
    "frontend/lib",
    "frontend/app/web",
    "frontend/app/mobile/lib",
    "frontend/app/mobile/planning",
    "frontend/app/mobile/volunteer",
    "frontend/app/mobile/kiosk"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:stream": "turbo dev --ui=stream",
    "generate:api": "bun scripts/generate-openapi-clients.ts",
    "check": "bun run --filter '*' typecheck",
    "typecheck": "bun run --filter @porphyra/auth typecheck && bun run --filter @porphyra/frontend typecheck && bun run --filter @porphyra/web typecheck"
  },
  "devDependencies": {
    "turbo": "^2.8.13",
    "typescript": "^5.9.3"
  }
}
