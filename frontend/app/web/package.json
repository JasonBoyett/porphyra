{
	"name": "@porphyra/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --force --host 0.0.0.0 --port 3000",
		"build": "tsc -b && vite build",
		"lint": "eslint src",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:golden": "playwright test --config playwright.golden.config.ts",
		"test:golden:update": "playwright test --config playwright.golden.config.ts --update-snapshots",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@porphyra/frontend": "workspace:*",
		"@tanstack/react-query": "^5.66.0",
		"@tanstack/react-router": "^1.114.0",
		"@vitejs/plugin-react": "^4.3.4",
		"axios": "^1.21.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"frimousse": "^0.4.0",
		"lucide-react": "^0.468.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.8.1",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^2.6.0",
		"vite": "^6.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/router-plugin": "^1.169.0",
		"@types/bun": "^1.4.4",
		"@types/react": "19.1.17",
		"@types/react-dom": "19.1.9",
		"eslint": "^10.15.0",
		"jsdom": "^28.1.0",
		"prettier": "^3.10.1",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.74.0",
		"vitest": "^4.1.0"
	}
}
